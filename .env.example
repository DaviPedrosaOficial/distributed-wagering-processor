NODE_ENV=development
PORT=3000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=wagering_db
POSTGRES_USER=wagering_user
POSTGRES_PASSWORD=wagering_password

# Banco separado; os testes de integração revertem e reaplicam migrations.
POSTGRES_TEST_DB=wagering_test

# Worker de referencias: habilitado por padrao na API.
REFERENCE_WORKER_ENABLED=true

# SQS local. Copie estas linhas para seu .env para habilitar os workers.
MESSAGING_ENABLED=true
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_REGION=us-east-1
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test
SQS_REQUEST_QUEUE=wager-transactions.fifo
SQS_DLQ=wager-transactions-dlq.fifo
SQS_EVENT_QUEUE=wager-events.fifo
