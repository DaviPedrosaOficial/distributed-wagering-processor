{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-test",
    "declaration": false,
    "incremental": false,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test-sqs/**/*.ts",
    "test-process/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-test"
  ]
}
