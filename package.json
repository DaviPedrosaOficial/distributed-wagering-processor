{
  "name": "distributed-wagering-processor",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun run build && bun ./dist/main.js",
    "start:prod": "bun ./dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test:clean": "bun -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\"",
    "test:build": "bun run test:clean && tsc -p tsconfig.test.json",
    "test": "bun run test:build && bun test",
    "test:unit": "bun run test:build && bun test ./dist-test/src",
    "test:e2e": "bun run test:build && bun test ./dist-test/test",
    "test:cov": "bun run test:build && bun test --coverage"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2",
    "@mikro-orm/migrations": "7.2",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2"
  }
}
